HOST=127.0.0.1
PORT=8766
# On your hosting service, set HOST=0.0.0.0 and APP_ORIGIN to your exact HTTPS website origin.
APP_ORIGIN=
# Public R2 custom-domain URL, e.g. https://media.example.com. Empty uses local video files.
MEDIA_CDN_BASE_URL=
# Public artwork CDN (also the default when unset). Explicit empty value keeps local artwork.
ARTWORK_CDN_BASE_URL=https://media.sofacet.com
# Immutable Cloudflare manifest for Option 2; empty uses the bundled fallback clips.
ENTRANCE_VIDEO_MANIFEST_URL=
# Native 4K manifest for the default version 3 entrance (falls back to 1080p).
ENTRANCE_VIDEO_4K_MANIFEST_URL=
# Use a private persistent disk directory for production player and score storage.
DATA_DIR=
# Set real rewards credentials through the hosting service, never in Git.
REWARDS_API_BASE=https://backend-production-082b.up.railway.app
REWARDS_API_KEY=
REWARDS_ADMIN_SECRET=
LEADERBOARD_MODE=game

# Google Analytics uses a public measurement ID and waits for Analytics consent.
# Keep disabled in local development and use fixture IDs only in tests.
ANALYTICS_ENABLED=false
ANALYTICS_ENVIRONMENT=production
APP_RELEASE=
GA4_MEASUREMENT_ID=
# Optional pseudonymous signed-in correlation; leave empty for anonymous analytics.
# If used, generate a separate random server-only secret of at least 32 characters.
ANALYTICS_ID_SECRET=
# PostHog public project token only (phc_...), never a private/personal API key.
# Browser usage and errors require Analytics consent; replay also requires its own choice.
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_SESSION_REPLAY=false
# Anonymous operational server errors, without request bodies, customer IDs or raw messages.
POSTHOG_SERVER_ERRORS=false

# Private source-map upload only; these credentials are never sent to a browser.
# Build maps first with npm run build; upload the exact matching private outputs separately.
POSTHOG_CLI_HOST=https://us.posthog.com
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_API_KEY=

# Server-only partner key enables the rewards OTP flow in membership-otp.mjs.
# Official public policy URLs; leave empty until approved. Both are required for registration.
MEMBERSHIP_TERMS_URL=
MEMBERSHIP_PRIVACY_URL=
